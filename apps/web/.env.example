# Central platform Postgres (accounts + encrypted connection tokens only)
DATABASE_URL="postgresql://user:password@localhost:5432/gcu_resume_studio"

# AES-256-GCM key for encrypting OAuth tokens / service-role keys at rest.
# Generate with: openssl rand -base64 32
MASTER_KEY=""

# Session signing secret (HMAC for the login cookie)
SESSION_SECRET=""

# --- Supabase Management API OAuth app (Settings -> OAuth Apps in your org) ---
SUPABASE_OAUTH_CLIENT_ID=""
SUPABASE_OAUTH_CLIENT_SECRET=""
SUPABASE_OAUTH_REDIRECT_URI="http://localhost:3000/api/connections/supabase/callback"
# Which Supabase org new student projects get created under.
SUPABASE_ORG_ID=""

# --- Cloudflare self-managed OAuth client (Manage account > OAuth clients) ---
CLOUDFLARE_OAUTH_CLIENT_ID=""
CLOUDFLARE_OAUTH_CLIENT_SECRET=""
CLOUDFLARE_OAUTH_REDIRECT_URI="http://localhost:3000/api/connections/cloudflare/callback"

APP_BASE_URL="http://localhost:3000"
