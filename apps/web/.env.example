# Central platform Postgres (accounts + encrypted connection tokens only)
DATABASE_URL="postgresql://user:password@localhost:5432/gcu_resume_studio"

# AES-256-GCM key for encrypting OAuth tokens / service-role keys at rest.
# Generate with: openssl rand -base64 32
MASTER_KEY=""

# Session signing secret (HMAC for the login cookie)
SESSION_SECRET=""

# --- Cloudflare self-managed OAuth client (Manage account > OAuth clients) ---
# Scopes: user-details.read, account-settings.read, workers-scripts.write,
# workers-kv-storage.write, d1.write. This client also needs "D1 Write" added
# to its own scope list on Cloudflare's dashboard (Manage account > OAuth
# clients > this client > Edit) — see lib/cloudflare.ts's CLOUDFLARE_OAUTH_SCOPES
# comment. Until that's done, a student's OAuth connection can't reach D1 and
# falls back to the "paste a scoped API token" path on the connect screen
# instead (needs Workers Scripts:Edit, Workers KV Storage:Edit, and D1:Edit on
# that token).
CLOUDFLARE_OAUTH_CLIENT_ID=""
CLOUDFLARE_OAUTH_CLIENT_SECRET=""
CLOUDFLARE_OAUTH_REDIRECT_URI="http://localhost:3000/api/connections/cloudflare/callback"

APP_BASE_URL="http://localhost:3000"
